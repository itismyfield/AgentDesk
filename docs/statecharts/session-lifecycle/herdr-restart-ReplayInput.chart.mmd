  state "At the same time" as all {
    state "Restart lifecycle B" as r0 {
      s0: Old session and original queued input
      s1: Restart excludes old input and captures exact pane
      s2: Exact close confirmed#59; settle old inflight
      s3: Old incarnation retired#59; originals still held
      s4: Fresh incarnation Pending before create
      s5: New pane created#59; wait for evidence and binding
      s6: One new Ready session#59; originals await the owner
      s7: One new Ready session#59; originals settled once
      s8: Original input executed twice
      [*] --> s0
      s0 --> s1: User /restart is accepted under transition and fence
      s1 --> s2: Close only the captured pane
      s2 --> s3: Retire and settle only the old token
      s3 --> s4: Commit new incarnation before create
      s4 --> s5: Create reply is observed once
      s5 --> s6: Evidence and binding admit the successor
      s6 --> s7: Submit an original to the successor once
      s7 --> s6: Forget an original receipt
      s6 --> s8: Submit an original to the successor once
    }
    --
    state "Codex resume helper A" as r1 {
      s9: Verified resume intent or ordinary fresh launch
      s10: Old End confirmed before EOF capture
      s11: EOF and O cursor agree#59; prepare immutable incarnation
      s12: Offset durably recorded before provider launch
      s13: Own startup metadata appended#59; seed not submitted
      s14: Process crashed#59; volatile reader state lost
      s15: Boot restored the original reader offset
      s16: Resume cause accepted#59; old history excluded
      [*] --> s9
      s9 --> s10: Confirm old provider End before EOF capture
      s10 --> s11: Compare post-End EOF with O cursor
      s11 --> s12: Persist reader offset and mode in the incarnation
      s12 --> s13: Launch once and observe own Startup or Resume
      s13 --> s14: Crash after startup metadata and before seed
      s14 --> s15: Recover the recorded incarnation and reader offset
      s15 --> s16: Bind the scoped cause and tail from the recorded offset
    }
  }
