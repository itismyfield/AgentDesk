title: "Herdr 재시작 재부착과 평소 입력 경로"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Breaks NoIdleOnly
    lg1: Path to the NoIdleOnly or ParityResolves bug
    lg2: Repeats forever, so ParityResolves breaks
  }
  class lg0 breaks
  class lg1 bugPath
  class lg2 repeats
  state "작업 중 pane" as s0 {
    state "이름 유일#183;nonce 일치" as s1 {
      s2: dcserver 종료
      s3: 첫 원본 대기
      s4: 같은 원본이 큐에 있음
      s5: 이름으로 pane 선택
      s6: watcher#183;진행 턴 lease#183;Busy grant 인수
      s7: 평소 composer 차단
      s8: 작업 중인데 Idle을 별도 요구
    }
  }
  [*] --> s2
  s2 --> s3: dcserver 부팅
  s3 --> s4: 같은 원본 수락
  s4 --> s4: intake reconcile 완료
  s4 --> s5: 현재 pane과 이름을 확인
  s5 --> s6: 위치#183;registry#183;watcher와 owner 인수
  s6 --> s7: 평소 입력 규칙 적용
  s6 --> s8: 평소 입력 규칙 적용
  s7 --> s6: composer가 입력 가능한 상태로 전환
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s2 bugPath
  class s3 bugPath
  class s4 bugPath
  class s5 bugPath
  class s6 bugPath
  class s8 breaks
  class s8 bugPath
  class s8 repeats
