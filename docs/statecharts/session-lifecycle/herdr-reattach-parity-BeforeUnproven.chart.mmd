---
title: "Herdr 재시작 재부착과 평소 입력 경로"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Breaks NoLiveDiscard
    lg1: Path to the NoLiveDiscard or ParityResolves bug
    lg2: Repeats forever, so ParityResolves breaks
  }
  class lg0 breaks
  class lg1 bugPath
  class lg2 repeats
  state "작업 중 pane" as s0 {
    state "이름 유일#183;nonce 일치" as s1 {
      s2: dcserver 종료
      s3: 첫 원본 대기
      s4: 같은 원본이 큐에 있음
      s5: 살아 있는 pane의 원본 폐기
    }
  }
  [*] --> s2
  s2 --> s3: dcserver 부팅
  s3 --> s4: 같은 원본 수락
  s3 --> s3: intake reconcile 완료
  s4 --> s4: intake reconcile 완료
  s4 --> s5: 현재 pane과 이름을 확인
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s2 bugPath
  class s3 bugPath
  class s4 bugPath
  class s5 breaks
  class s5 bugPath
  class s5 repeats
