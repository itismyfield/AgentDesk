  state "At the same time" as all {
    state "Restart lifecycle B" as r0 {
      s0: Old session and original queued input
      s1: Restart excludes old input and captures exact pane
      s2: Failure awaiting a visible result
      [*] --> s0
      s0 --> s1: User /restart is accepted under transition and fence
      s1 --> s2: Exact close is unconfirmed
    }
    --
    state "Codex resume helper A" as r1 {
      s3: Verified resume intent or ordinary fresh launch
      s4: Old End confirmed before EOF capture
      s5: EOF and O cursor agree#59; prepare immutable incarnation
      s6: Offset durably recorded before provider launch
      s7: Own startup metadata appended#59; seed not submitted
      s8: Process crashed#59; volatile reader state lost
      s9: Boot restored the original reader offset
      s10: Resume cause accepted#59; old history excluded
      [*] --> s3
      s3 --> s4: Confirm old provider End before EOF capture
      s4 --> s5: Compare post-End EOF with O cursor
      s5 --> s6: Persist reader offset and mode in the incarnation
      s6 --> s7: Launch once and observe own Startup or Resume
      s7 --> s8: Crash after startup metadata and before seed
      s8 --> s9: Recover the recorded incarnation and reader offset
      s9 --> s10: Bind the scoped cause and tail from the recorded offset
    }
  }
