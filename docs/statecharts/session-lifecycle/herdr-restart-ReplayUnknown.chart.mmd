title: "Separate contracts: restart lifecycle B and Codex resume helper A"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: Contract
    lg1: Breaks ABootOffsetStable or ANoNewPrefixSkip or AOffsetPreserved or NoBlindCreate
    lg2: Path to the ABootOffsetStable or ANoNewPrefixSkip or AOffsetPreserved or NoBlindCreate bug
  }
  class lg0 blue
  class lg1 breaks
  class lg2 bugPath
  state "At the same time" as all {
    state "Restart lifecycle B" as r0 {
      s0: Old session and original queued input
      s1: Restart excludes old input and captures exact pane
      s2: Exact close confirmed#59; settle old inflight
      s3: Old incarnation retired#59; originals still held
      s4: Fresh incarnation Pending before create
      s5: Unknown create acknowledgement was replayed
      [*] --> s0
      s0 --> s1: User /restart is accepted under transition and fence
      s1 --> s2: Close only the captured pane
      s2 --> s3: Retire and settle only the old token
      s3 --> s4: Commit new incarnation before create
      s4 --> s5: Create reply is observed once
    }
    --
    state "Codex resume helper A" as r1 {
      s6: Verified resume intent or ordinary fresh launch
      s7: Old End confirmed before EOF capture
      s8: EOF and O cursor agree#59; prepare immutable incarnation
      s9: Offset durably recorded before provider launch
      s10: Own startup metadata appended#59; seed not submitted
      s11: Process crashed#59; volatile reader state lost
      s12: Boot replaced the recorded offset
      s13: Recovered reader skips new prefix
      [*] --> s6
      s6 --> s7: Confirm old provider End before EOF capture
      s7 --> s8: Compare post-End EOF with O cursor
      s8 --> s9: Persist reader offset and mode in the incarnation
      s9 --> s10: Launch once and observe own Startup or Resume
      s10 --> s11: Crash after startup metadata and before seed
      s11 --> s12: Recover the recorded incarnation and reader offset
      s12 --> s13: Bind the scoped cause and tail from the recorded offset
    }
  }
