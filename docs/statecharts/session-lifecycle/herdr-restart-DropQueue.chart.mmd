---
title: "Separate contracts: restart lifecycle B and Codex resume helper A"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: Contract
    lg1: Breaks ACursorAgreement or InputCustody
    lg2: Path to the ACursorAgreement or AcceptedInputResolves or InputCustody bug
    lg3: Repeats forever, so AcceptedInputResolves breaks
  }
  class lg0 blue
  class lg1 breaks
  class lg2 bugPath
  class lg3 repeats
  state "At the same time" as all {
    state "Restart lifecycle B" as r0 {
      s0: Old session and original queued input
      s1: Restart excludes old input and captures exact pane
      s2: Exact close confirmed#59; settle old inflight
      s3: Accepted input lost its owner
      [*] --> s0
      s0 --> s1: User /restart is accepted under transition and fence
      s1 --> s2: Close only the captured pane
      s2 --> s3: Retire and settle only the old token
    }
    --
    state "Codex resume helper A" as r1 {
      s4: Verified resume intent or ordinary fresh launch
      s5: Old End confirmed before EOF capture
      s6: Resume accepted a mismatched O cursor
      [*] --> s4
      s4 --> s5: Confirm old provider End before EOF capture
      s5 --> s6: Compare post-End EOF with O cursor
    }
  }
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 blue
  class s0 bugPath
  class s1 blue
  class s1 bugPath
  class s2 blue
  class s2 bugPath
  class s3 blue
  class s3 breaks
  class s3 bugPath
  class s3 repeats
  class s4 blue
  class s4 bugPath
  class s5 blue
  class s5 bugPath
  class s6 blue
  class s6 breaks
  class s6 bugPath
  class s6 repeats
