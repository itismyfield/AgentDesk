stateDiagram-v2
  state "Legend" as legend {
    lg0: Result
    lg1: Restart
    lg2: Owner
    lg3: Breaks NoResumeAfterClear or NoSeedAfterClear or NoSeedRevival
    lg4: Path to the ClearForgets or NoResumeAfterClear or NoSeedAfterClear or NoSeedRevival bug
