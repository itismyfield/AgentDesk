stateDiagram-v2
  state "Legend" as legend {
    lg0: Result
    lg1: Restart
    lg2: Owner
    lg3: Breaks NoBlindCreate or SingleSession
    lg4: Path to the AcceptedInputResolves or NoBlindCreate or SingleSession bug
    lg5: Repeats forever, so AcceptedInputResolves breaks
  }
  class lg0 teal
  class lg1 blue
  class lg2 purple
  class lg3 breaks
  class lg4 bugPath
