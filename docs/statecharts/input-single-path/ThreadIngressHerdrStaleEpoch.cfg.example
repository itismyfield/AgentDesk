\* EXPECTED_SAFETY=HerdrCurrentExecutor EXPECTED_LIVENESS=-
CONSTANTS
    Target = "boundChannel"
    InitialSession = "live"
    ActualHost = "herdr"
    DesiredHost = "herdr"
    Mutation = "herdrStaleEpoch"
    CanCrash = TRUE
SPECIFICATION HerdrSpec
INVARIANT HerdrExactlyOnce HerdrNoSilentLoss HerdrRejectedNoEffects HerdrExternalWired HerdrReservationReturned HerdrCurrentExecutor HerdrSourcePreserved
PROPERTY HerdrAcceptedStarts HerdrAcceptedCompletes HerdrDeliveredGetsOutcome
