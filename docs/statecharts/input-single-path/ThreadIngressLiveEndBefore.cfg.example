\* EXPECTED_SAFETY=- EXPECTED_LIVENESS=EligibleEnds,NextCanProgress
SPECIFICATION Spec
CONSTANTS Source = "absent"
          Exact = TRUE
          ExecutionEnded = TRUE
          Mutation = "omitLiveEnd"
INVARIANTS TypeOK TerminalReaderOnly UnknownHeld SettlementAfterDelivery DoneNoResidue
PROPERTIES EligibleEnds NextCanProgress
CHECK_DEADLOCK FALSE
