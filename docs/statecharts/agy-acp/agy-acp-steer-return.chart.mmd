---
title: "agy acp channel session: one terminal post per person input"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Restart
    lg1: Process
    lg2: Turn
    lg3: Session
    lg4: Breaks DurableOwner in some cases
    lg5: Path to the DurableOwner or EveryInputSettles bug
    lg6: Repeats forever, so EveryInputSettles breaks
  }
  class lg0 pink
  class lg1 tan
  class lg2 blue
  class lg3 teal
  class lg4 mayBreak
  class lg5 bugPath
  class lg6 repeats
  s0: No agy child
  s1: Child up, no session
  s2: Session idle
  s3: Prompt open
  s4: Turn steered: two prompts open
  s5: Rejected steer held in memory only
  s6: Prompt open, stop asked
  s7: AgentDesk restarting
  s8: Input sent, nothing will answer it
  [*] --> s0
  s0 --> s0: a person sends a message
  s0 --> s1: AgentDesk starts agy acp
  s1 --> s1: a person sends a message or person runs /clear (a steer being returned is discarded too)
  s1 --> s2: session/new or agy refuses the stored id#59; session/new
  s2 --> s3: session/prompt for the next input (new turn, or steer while a prompt is open)
  s2 --> s0: agy exits#59; stdout EOF fails open prompts
  s3 --> s4: session/prompt for the next input (new turn, or steer while a prompt is open)
  s4 --> s5: steer prompt rejected before execution
  s4 --> s3: agy answers the prompt (stopReason)
  s3 --> s6: person sends !stop
  s6 --> s5: steer prompt rejected before execution
  s5 --> s7: AgentDesk restarts
  s7 --> s8: boot settles orphaned prompts
  s8 --> s8: writer posts the turn's one terminal message (covers steered inputs) or boot kills the old child's process group
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 tan
  class s0 bugPath
  class s1 teal
  class s1 bugPath
  class s2 teal
  class s2 bugPath
  class s3 blue
  class s3 bugPath
  class s4 blue
  class s4 bugPath
  class s5 mayBreak
  class s5 bugPath
  class s6 blue
  class s6 bugPath
  class s7 pink
  class s7 bugPath
  class s8 tan
  class s8 bugPath
  class s8 repeats
