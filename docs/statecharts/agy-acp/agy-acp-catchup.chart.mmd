---
title: "agy acp channel session: one terminal post per person input"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Restart
    lg1: Process
    lg2: Turn
    lg3: Session
    lg4: Breaks NoReviveAfterClear
    lg5: Breaks NoDuplicateExecution in some cases
    lg6: Path to the NoDuplicateExecution or NoReviveAfterClear bug
  }
  class lg0 pink
  class lg1 tan
  class lg2 blue
  class lg3 teal
  class lg4 breaks
  class lg5 mayBreak
  class lg6 bugPath
  s0: No agy child
  s1: Child up, no session
  s2: Session idle
  s3: Input accepted, prompt not yet written
  s4: Prompt open
  s5: AgentDesk restarting
  s6: Old child orphaned, sweep pending
  [*] --> s0
  s0 --> s0: a person sends a message
  s0 --> s1: AgentDesk starts agy acp
  s1 --> s2: session/new or reattach the stored id (resume, or load)
  s2 --> s3: actor accepts the next input (new turn, or steer while a prompt is open)
  s3 --> s3: the input's origin is written ahead into the turn's inflight row
  s3 --> s1: person runs /clear
  s3 --> s4: session/prompt for the saved input (dropped as a failed steer if its turn is stopping)
  s1 --> s5: AgentDesk restarts
  s4 --> s0: agy exits#59; stdout EOF fails open prompts
  s5 --> s6: boot settles orphaned prompts
  s0 --> s5: AgentDesk restarts
  s5 --> s0: boot settles orphaned prompts
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 tan
  class s0 bugPath
  class s1 teal
  class s1 bugPath
  class s2 teal
  class s2 bugPath
  class s3 teal
  class s3 bugPath
  class s4 blue
  class s4 mayBreak
  class s4 bugPath
  class s5 pink
  class s5 bugPath
  class s6 tan
  class s6 breaks
  class s6 bugPath
