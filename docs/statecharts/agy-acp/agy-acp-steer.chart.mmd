---
title: "agy acp channel session: one terminal post per person input"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Process
    lg1: Turn
    lg2: Session
    lg3: Breaks AnswerCoversWholeSteer or NoAnswerForRefusedSteer in some cases
    lg4: Path to the AnswerCoversWholeSteer or NoAnswerForRefusedSteer bug
  }
  class lg0 tan
  class lg1 blue
  class lg2 teal
  class lg3 mayBreak
  class lg4 bugPath
  s0: No agy child
  s1: Child up, no session
  s2: Session idle
  s3: Prompt open
  s4: Turn steered: two prompts open
  [*] --> s0
  s0 --> s0: a person sends a message
  s0 --> s1: AgentDesk starts agy acp
  s1 --> s2: session/new
  s2 --> s3: session/prompt for the next input (new turn, or steer while a prompt is open)
  s3 --> s4: session/prompt for the next input (new turn, or steer while a prompt is open)
  s4 --> s3: agy answers the prompt (stopReason)
  s3 --> s3: writer posts the turn's one terminal message (covers steered inputs, notes failed steers)
  s3 --> s2: steer prompt fails (rejected, or outcome unknown)#59; it stays in the turn
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 tan
  class s0 bugPath
  class s1 teal
  class s1 bugPath
  class s2 teal
  class s2 mayBreak
  class s2 bugPath
  class s3 blue
  class s3 mayBreak
  class s3 bugPath
  class s4 blue
  class s4 bugPath
